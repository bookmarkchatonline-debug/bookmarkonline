{
  "appId": "online.bookmarkchat.app",
  "appName": "BookmarkChat",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          }
        }
      }
    }
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b0713",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "SystemBars": {
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  }
}
