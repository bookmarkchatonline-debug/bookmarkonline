  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "expo:start": "npm --prefix mobile-expo run start",
    "expo:tunnel": "npm --prefix mobile-expo exec expo start -- --tunnel",
